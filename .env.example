# Copy to .env for local development. Never commit real values.

PORT=3000
DB_PATH=.local/overrule.db
APP_URL=http://localhost:3000

# LLM providers. Without keys the app still works end-to-end from the verified drill pool.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Optional cheaper model for grading the short "why" notes (defaults to CLAUDE_MODEL)
CLAUDE_FAST_MODEL=
GEMINI_MODEL=gemini-3.5-flash

# Protects /metrics?token=…
METRICS_TOKEN=

# Cost guards: live generations per session / across all sessions, per ET day
GEN_LIMIT_PER_SESSION=12
GEN_LIMIT_GLOBAL=600
# Ceiling on total model spend in US dollars, estimated from token counts at list prices.
# At the ceiling the app stops calling models and serves the verified pool.
LLM_BUDGET_USD=20
