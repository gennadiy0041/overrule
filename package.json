{
  "name": "overrule",
  "version": "0.1.0",
  "private": true,
  "description": "Overrule — a 5-minute daily drill and rating for the skill of reviewing AI's work.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "bun src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "e2e": "playwright test",
    "import-data": "bun scripts/import-data.ts",
    "generate-pool": "bun scripts/generate-pool.ts",
    "seed-demo": "bun scripts/seed-demo.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "build-deck": "bun scripts/build-deck.ts",
    "record-demo": "bun scripts/record-demo.ts"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
